# =============================================================
#  Zoho Books — Hotel Automation System
#  ملف الإعدادات — انسخه إلى config.env وعبئ القيم
# =============================================================

# --- Zoho OAuth2 Credentials ---
# احصل عليها من: https://api-console.zoho.com/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Refresh Token (يُولَّد مرة واحدة عبر OAuth flow)
ZOHO_REFRESH_TOKEN=

# Organization ID — من Settings > Organization Profile
ZOHO_ORG_ID=

# Base URL — غيّرها حسب منطقتك:
#   US: https://www.zohoapis.com/books/v3
#   EU: https://www.zohoapis.eu/books/v3
#   IN: https://www.zohoapis.in/books/v3
ZOHO_BASE_URL=https://www.zohoapis.com/books/v3

# Token endpoint — غيّرها حسب منطقتك:
#   US: https://accounts.zoho.com/oauth/v2/token
#   EU: https://accounts.zoho.eu/oauth/v2/token
ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token

# --- WhatsApp Business API (Meta) ---
# من Meta Developer Portal > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=my_secret_verify_token_2026

# --- LLM (Google Gemini Flash — مجاناً) ---
# احصل على مفتاحك من: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AQ.Ab8RN6LzYOZQR_h9DTrfD0gcpqFWhVbmKEgqooZ2K5jGprLKDg

# --- n8n Webhook Base URL ---
N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# =============================================================
# تعليمات الحصول على Refresh Token:
# 1. افتح: https://accounts.zoho.com/developerconsole
# 2. اختر تطبيقك → Self Client
# 3. أدخل الـ Scopes:
#    ZohoBooks.settings.CREATE,ZohoBooks.settings.READ,
#    ZohoBooks.accountants.CREATE,ZohoBooks.accountants.READ,
#    ZohoBooks.invoices.CREATE,ZohoBooks.bills.CREATE,
#    ZohoBooks.journals.CREATE
# 4. اضغط Generate → احفظ الـ code
# 5. شغّل: python 01_auth.py --init --code=YOUR_CODE
# =============================================================
