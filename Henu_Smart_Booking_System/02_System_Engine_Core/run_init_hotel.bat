@echo off
chcp 65001 > nul
title تحديث ومزامنة بيانات فندق هينو (محلياً وسحابياً)
cd /d "%~dp0"

echo ================================================================
echo       نظام فندق هينو الذكي - تحديث البيانات من شيت الإكسل
echo ================================================================
echo.

where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطأ]: برنامج Node.js غير مثبت على هذا الجهاز!
    echo.
    pause
    exit /b 1
)

echo [1/2] جاري قراءة وتحديث بيانات الغرف والأسعار محلياً...
echo.
node src\excel_importer.js

echo.
echo [2/2] جاري المزامنة مع سحابة Firebase Cloud (24/7)...
echo.
node src\firebase_sync.js

echo.
echo ================================================================
echo تمت المزامنة بنجاح تام محلياً وعلى سحابة Firebase!
echo ================================================================
echo.
pause
